# Public URL used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.phonerepairs.nl

# Keep "false" until the client approves launch. When "false" the site sends
# noindex (meta + X-Robots-Tag) and robots.txt disallows everything.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Demo mode shows data-status notes (e.g. "prijs nog niet geïmporteerd").
NEXT_PUBLIC_DEMO_MODE=true

# Migration crawler
# SOURCE_ORIGIN=https://www.phonerepairs.nl
# REQUEST_DELAY_MS=1000
# MAX_CRAWL=300

# Licensed iPhone 17 exploded-view model (GLB). Unset = procedural stand-in.
# NEXT_PUBLIC_IPHONE_MODEL_URL=/models/iphone-17-exploded.glb

# Kiyoh review feed hash (from the client's Kiyoh account / WordPress plugin), read by
# `npm run reviews:fetch` before each build. Never prefix with NEXT_PUBLIC_.
# Unset = Kiyoh badges show a plain link without score.
# KIYOH_FEED_HASH=

# Online send-in form (/veelgestelde-vragen/reparatie-opsturen) → the shop's inbox, via Resend.
# Server-side secrets: never prefix with NEXT_PUBLIC_. All three unset = nothing is sent and
# the form says so (it then offers WhatsApp, e-mail and printing).
# RESEND_API_KEY=
# FORM_MAIL_TO=info@phonerepairs.nl
# FORM_MAIL_FROM=Phone Repairs website <formulier@phonerepairs.nl>

# CMS (Keystatic, /keystatic), see docs/cms.md. Unset = local files (npm run dev only); the
# deployed admin stays switched off until GitHub storage is configured.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
# NEXT_PUBLIC_KEYSTATIC_REPO=juliusvanhelmond-stack/phone-repairs-den-bosch
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
