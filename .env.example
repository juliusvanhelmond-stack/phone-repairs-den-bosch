# Public URL used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.phonerepairs.nl

# Keep "false" until the client approves launch. When "false" the site sends
# noindex (meta + X-Robots-Tag) and robots.txt disallows everything.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Demo mode shows data-status notes (e.g. "prijs nog niet geïmporteerd").
NEXT_PUBLIC_DEMO_MODE=true

# Migration crawler
# SOURCE_ORIGIN=https://www.phonerepairs.nl
# REQUEST_DELAY_MS=1000
# MAX_CRAWL=300
